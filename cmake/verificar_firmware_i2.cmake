# Verificar el firmware integrado de I2: arranque del reloj, las 3 ISR propias en
# sus vectores, sin flotantes, libc ni simbolos indefinidos. Verificacion estatica
# del ELF ya enlazado; no ejecuta codigo ARM.
foreach(required SOURCE_DIR ELF TOOL_PREFIX PYTHON)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Falta parametro ${required}")
    endif()
endforeach()
execute_process(COMMAND "${PYTHON}" "${SOURCE_DIR}/scripts/verificar_elf.py"
    "${ELF}" --tool-prefix "${TOOL_PREFIX}" --exigir-reloj
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Firmware I2 invalido: ${output} ${errors}")
endif()
execute_process(COMMAND "${TOOL_PREFIX}nm" "${ELF}"
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "No se pudieron inspeccionar simbolos del firmware: ${errors}")
endif()
foreach(required_symbol main Reloj_Init SystemInit SystemCoreClockUpdate
        TIMER0_IRQHandler UART0_IRQHandler DMA_IRQHandler)
    if(NOT symbols MATCHES "[0-9a-f]+ T ${required_symbol}[\r\n]")
        message(FATAL_ERROR "Funcion/ISR del firmware ausente o no global fuerte: ${required_symbol}")
    endif()
endforeach()
foreach(default_handler ADC_IRQHandler TIMER1_IRQHandler PWM1_IRQHandler UART1_IRQHandler)
    if(NOT symbols MATCHES "[0-9a-f]+ W ${default_handler}[\r\n]")
        message(FATAL_ERROR "ISR no prevista con definicion fuerte: ${default_handler}")
    endif()
endforeach()
if(symbols MATCHES "__aeabi_[fd]")
    message(FATAL_ERROR "El firmware no admite auxiliares flotantes: ${symbols}")
endif()
foreach(libc_symbol printf malloc free memcpy memset strlen)
    if(symbols MATCHES " [TtWw] ${libc_symbol}[\r\n]")
        message(FATAL_ERROR "El firmware no admite libc: ${libc_symbol}")
    endif()
endforeach()
execute_process(COMMAND "${TOOL_PREFIX}nm" --undefined-only "${ELF}"
    RESULT_VARIABLE result OUTPUT_VARIABLE undefined_symbols ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT undefined_symbols STREQUAL "")
    message(FATAL_ERROR "El firmware tiene simbolos indefinidos: ${undefined_symbols} ${errors}")
endif()
get_filename_component(TPI_ELF_DIR "${ELF}" DIRECTORY)
execute_process(COMMAND "${TOOL_PREFIX}objcopy" -O binary -j .isr_vector
    "${ELF}" "${TPI_ELF_DIR}/vectores-i2.bin"
    RESULT_VARIABLE result OUTPUT_VARIABLE output_vectors ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "No se pudo extraer la tabla de vectores: ${errors}")
endif()
file(READ "${TPI_ELF_DIR}/vectores-i2.bin" vectors HEX)
foreach(entry "TIMER0_IRQHandler;17" "UART0_IRQHandler;21" "DMA_IRQHandler;42")
    list(GET entry 0 handler)
    list(GET entry 1 index)
    string(REGEX MATCH "([0-9a-f]+) T ${handler}[\r\n]" unused "${symbols}")
    math(EXPR expected "0x${CMAKE_MATCH_1} | 1")
    math(EXPR offset "${index} * 8")
    string(SUBSTRING "${vectors}" ${offset} 8 word)
    string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" word "${word}")
    math(EXPR actual "0x${word}")
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "Vector ${index} no apunta a ${handler}: 0x${word}")
    endif()
endforeach()
message(STATUS "Firmware I2: reloj primero, 3 ISR en sus vectores, sin flotantes, libc ni indefinidos; no ejecutado en MCU. ${output}")
